    {
      "id": "assets_scripts_pdf_blockmerge3d_seviye_uretim_sistemi_v2_level_gen_spec",
      "label": "Level Generation System v2 Spec",
      "file_type": "document",
      "source_file": "/home/emre/Belgeler/GitHub/BlockMerge3D/Assets/Scripts/PDF/BlockMerge3D_Seviye_Uretim_Sistemi_v2.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "assets_scripts_pdf_blockmerge3d_seviye_uretim_sistemi_v2_solution_first_generation",
      "label": "Solution-First Generation Principle",
      "file_type": "rationale",
      "source_file": "/home/emre/Belgeler/GitHub/BlockMerge3D/Assets/Scripts/PDF/BlockMerge3D_Seviye_Uretim_Sistemi_v2.md",
      "source_location": "Section 2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Levels are built solution-first: pieces placed via backtracking into a solved grid, solution trace recorded, then pieces scrambled for player presentation. This guarantees solvability at generation time."
    },
    {
      "id": "assets_scripts_pdf_blockmerge3d_seviye_uretim_sistemi_v2_collapse_aware_grid",
      "label": "Collapse-Aware Grid Model",
      "file_type": "rationale",
      "source_file": "/home/emre/Belgeler/GitHub/BlockMerge3D/Assets/Scripts/PDF/BlockMerge3D_Seviye_Uretim_Sistemi_v2.md",
      "source_location": "Section 3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The board is not a static box but a collapsing system: when a layer is cleared, all cells above shift down by one and gridMaxY decreases. The generation system must simulate this collapse during solution building and validation."
    },
    {
      "id": "assets_scripts_pdf_blockmerge3d_seviye_uretim_sistemi_v2_piece_definition",
      "label": "PieceDefinition ScriptableObject",
      "file_type": "concept",
      "source_file": "/home/emre/Belgeler/GitHub/BlockMerge3D/Assets/Scripts/PDF/BlockMerge3D_Seviye_Uretim_Sistemi_v2.md",
      "source_location": "Section 4",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "assets_scripts_pdf_blockmerge3d_seviye_uretim_sistemi_v2_difficulty_formula",
      "label": "Level Difficulty Scoring Formula",
      "file_type": "rationale",
      "source_file": "/home/emre/Belgeler/GitHub/BlockMerge3D/Assets/Scripts/PDF/BlockMerge3D_Seviye_Uretim_Sistemi_v2.md",
      "source_location": "Section 5-6",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "levelDifficulty = 0.20*pieceCountScore + 0.18*Y_LayerComplexity + 0.18*delayedFailureRatio + 0.16*orderDependencyScore + 0.14*branchingFactorScore + 0.14*pieceSimilarityRatio. Ranges: 0-24 Easy, 25-49 Medium, 50-74 Hard, 75-100 Expert."
    },
    {
      "id": "assets_scripts_pdf_blockmerge3d_seviye_uretim_sistemi_v2_ice_mechanic",
      "label": "Ice (Buz) Mechanic",
      "file_type": "rationale",
      "source_file": "/home/emre/Belgeler/GitHub/BlockMerge3D/Assets/Scripts/PDF/BlockMerge3D_Seviye_Uretim_Sistemi_v2.md",
      "source_location": "Section 2.2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Ice melting uses flood-fill same-color groups: a connected group of >=2 same-color cells touching ice causes the ice to melt AND the entire group to be destroyed. This makes ice levels non-deterministic since piece colors are random. The generator adds 3 spare cells per ice cell as a buffer."
    },
    {
      "id": "assets_scripts_pdf_blockmerge3d_seviye_uretim_sistemi_v2_deadlock_detection",
      "label": "Deadlock / Game Over Detection",
      "file_type": "rationale",
      "source_file": "/home/emre/Belgeler/GitHub/BlockMerge3D/Assets/Scripts/PDF/BlockMerge3D_Seviye_Uretim_Sistemi_v2.md",
      "source_location": "Section 8",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Fixed bug where IsShapePlaceable checked ALL uncleared layers instead of only ActiveLayerY. Deadlock is now: no card in hand can be placed in any of 6 rotations on the active layer only."
    },
    {
      "id": "assets_scripts_pdf_blockmerge3d_seviye_uretim_sistemi_v2_merge_hint_system",
