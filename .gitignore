# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
mono_crash.*.blob

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Android imzalama — keystore ASLA repoya girmemeli.
# Sızarsa uygulaman başkası tarafından imzalanabilir; kaybedersen
# uygulamayı bir daha güncelleyemezsin. Ayrı ve yedekli bir yerde tut.
*.keystore
*.jks
keystore.properties

# ─── Firebase Unity SDK ─────────────────────────────────────────────
# SDK bir bağımlılıktır: yüzlerce MB native binary (bazı dosyalar 100MB+,
# GitHub reddediyor) ve yeniden import edilebilir. Repoya KOYMUYORUZ.
# Başka makinede: Firebase Unity SDK 12.10.0'ı import et + Force Resolve.
# (FirebaseManager.cs / FirestoreAnalytics.cs Assets/Scripts'te, commit'lenir.)
/[Aa]ssets/Firebase/
/[Aa]ssets/Firebase.meta
/[Aa]ssets/GeneratedLocalRepo/
/[Aa]ssets/GeneratedLocalRepo.meta
/[Aa]ssets/ExternalDependencyManager/
/[Aa]ssets/ExternalDependencyManager.meta
/[Aa]ssets/[Ee]ditor Default Resources/Firebase/
/[Aa]ssets/Plugins/Android/FirebaseApp.androidlib/
/[Aa]ssets/Plugins/Android/FirebaseApp.androidlib.meta
/[Aa]ssets/Plugins/Android/FirebaseCrashlytics.androidlib/
/[Aa]ssets/Plugins/Android/FirebaseCrashlytics.androidlib.meta
/[Aa]ssets/Plugins/iOS/Firebase/
/[Aa]ssets/Plugins/tvOS/Firebase/
